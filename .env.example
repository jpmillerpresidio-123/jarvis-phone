# ─────────────────────────────────────────────────────────────
# Personal AI Assistant: environment variables (placeholders only)
# Copy to .env for local development. In production, set these in
# Railway (backend) and Vercel (dashboard). Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── Backend (Railway) ────────────────────────────────────────
NODE_ENV=production
PORT=8080
# Public https URL of the Railway service (no trailing slash)
PUBLIC_BASE_URL=https://your-backend.up.railway.app
# Your Vercel dashboard URL (for CORS and OAuth redirects back)
DASHBOARD_ORIGIN=https://your-dashboard.vercel.app

# Claude API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies on the phone; raise to medium if answers feel shallow
CLAUDE_EFFORT=low
SUMMARY_MODEL=claude-opus-5-5

# Twilio (console.twilio.com). Inbound calls only.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_PHONE_NUMBER=+15555550100
# Only these numbers can talk to the assistant (comma-separated, E.164)
ALLOWED_CALLERS=+15555550123
# Keypad PIN: not used (leave empty). Sensitive actions are confirmed by voice.
VOICE_PIN=

# Supabase (Project settings → API). The service-role key stays on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# The only account allowed into the dashboard
OWNER_EMAIL=you@example.com

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_ME

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Blackbaud assignment feed (Assignment Center → calendar/iCal link). Works like a
# password: server only. Leave empty if you don't use it.
BLACKBAUD_ICAL=

# Cost tracking
MONTHLY_BUDGET_USD=50
HOSTING_MONTHLY_USD=5

# Local testing only. The server refuses to start with this in production.
# SKIP_TWILIO_SIGNATURE=true

# ── Dashboard (Vercel) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The anon/publishable key is designed to be public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
# Local development without Supabase only:
# NEXT_PUBLIC_DEV_TOKEN=dev-local
